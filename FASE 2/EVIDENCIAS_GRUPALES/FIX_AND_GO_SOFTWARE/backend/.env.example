DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TOKEN_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=

# Solo para demostraciones locales. Nunca cobra dinero real.
PAYMENTS_DEMO_ENABLED=false
DEMO_VAT_PERCENT=19

# Webpay Plus de integración: credenciales públicas, nunca cobros reales.
WEBPAY_INTEGRATION_ENABLED=false
WEBPAY_RETURN_URL=http://localhost:8000/api/v1/webpay/return/
WEBPAY_APP_URL=http://localhost:8091/
